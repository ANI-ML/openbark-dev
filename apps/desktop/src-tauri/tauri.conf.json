{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenBark",
  "version": "0.1.0",
  "identifier": "health.animl.openbark",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenBark",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$LOCALDATA/OpenBark/sessions/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "ANI-ML",
    "copyright": "Copyright 2026 ANI-ML. Apache-2.0.",
    "category": "Medical",
    "shortDescription": "A veterinary scribe that stays on this computer",
    "longDescription": "OpenBark records the consult and drafts the note. The audio, transcript and records never leave this computer.",
    "homepage": "https://github.com/ANI-ML/openbark",
    "licenseFile": "../../../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist"
    }
  }
}
